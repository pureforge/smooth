{
  "name": "@pureforge/smooth",
  "version": "0.1.2",
  "description": "Smooth — local-first project development harness for AI coding assistants",
  "keywords": [
    "smooth",
    "cli",
    "ai",
    "agent",
    "workflow",
    "development",
    "harness",
    "verification"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "smooth": "./bin/smooth.js"
  },
  "files": [
    "bin",
    "src/changes.js",
    "src/check.js",
    "src/graph.js",
    "src/init.js",
    "src/status.js",
    "src/validate.js",
    "templates"
  ],
  "scripts": {
    "lint": "node --check bin/smooth.js && node --check src/*.js",
    "verify": "npm run lint && npm test",
    "test": "node --test src/*.test.js"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
